<!DOCTYPE html>
<html lang="es-PE">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portal de Campañas</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar-portal">
        <div class="container d-flex justify-content-between align-items-center">
            <a class="navbar-brand-portal" asp-controller="Home" asp-action="Index">
                <span class="brand-icon"><i class="bi bi-grid-2x2-fill"></i></span>
                RetailCam
            </a>
            <div class="nav-portal">
                <a asp-controller="Campanas" asp-action="Index"
                   class="nav-btn @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Campanas" ? "active" : "")">
                    <i class="bi bi-list-ul"></i> Listado
                </a>
                <a asp-controller="Campanas" asp-action="Index" asp-route-mostrarFiltro="true"
                   class="nav-btn">
                    <i class="bi bi-funnel"></i> Filtrar
                </a>
                <a asp-controller="Campanas" asp-action="Resumen"
                   class="nav-btn @(ViewContext.RouteData.Values["action"]?.ToString() == "Resumen" ? "active" : "")">
                    <i class="bi bi-bar-chart-line"></i> Resumen
                </a>
            </div>
        </div>
    </nav>

    <main class="pb-5">
        @RenderBody()
    </main>

    <footer class="footer-portal">
        <div class="container">
            &copy; 2026 Portal de Campañas &mdash; Departamento de Marketing &mdash;
            Desarrollado con .NET 8 MVC
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
