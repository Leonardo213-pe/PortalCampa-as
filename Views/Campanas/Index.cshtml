@model List<PortalCampanas.Models.Campana>
@{
    ViewData["Title"] = "Campañas Comerciales";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 fw-bold mb-0">Campañas Comerciales</h1>
        <span style="font-size:.85rem;color:#6b7280;">@Model.Count resultado(s)</span>
    </div>

    @* Panel de filtros *@
    <div class="filtro-panel">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-semibold" style="font-size:.85rem;">Categoría</label>
                <select name="categoria" class="form-select form-select-sm">
                    <option value="">Todas las categorías</option>
                    @foreach (var cat in ViewBag.Categorias as List<string> ?? new List<string>())
                    {
                        <option value="@cat" selected="@(ViewBag.CategoriaSeleccionada == cat ? "selected" : null)">@cat</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold" style="font-size:.85rem;">Estado</label>
                <select name="estado" class="form-select form-select-sm">
                    <option value="">Todos los estados</option>
                    @foreach (var est in ViewBag.Estados as List<string> ?? new List<string>())
                    {
                        <option value="@est" selected="@(ViewBag.EstadoSeleccionado == est ? "selected" : null)">@est</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn-filtrar">Aplicar filtro</button>
                <a asp-action="Index" class="btn-limpiar">Limpiar</a>
            </div>
        </form>
    </div>

    @if (Model.Count == 0)
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-search" style="font-size:2.5rem;"></i>
            <p class="mt-3">No se encontraron campañas con esos filtros.</p>
            <a asp-action="Index" class="btn-limpiar">Ver todas</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
            @foreach (var c in Model)
            {
                var badgeClass = c.Estado switch
                {
                    "Vigente"    => "badge-vigente",
                    "Próxima"    => "badge-proxima",
                    "Finalizada" => "badge-finalizada",
                    _            => "badge-finalizada"
                };
                var catIcon = c.Categoria switch
                {
                    "Tecnología" => "bi-cpu",
                    "Hogar"      => "bi-house",
                    "Moda"       => "bi-bag",
                    "Electro"    => "bi-lightning-charge",
                    _            => "bi-tag"
                };
                <div class="col">
                    <div class="campaign-card h-100">
                        <div class="campaign-card-header">
                            <div class="campaign-name">@c.Nombre</div>
                            <span class="badge-estado @badgeClass">@c.Estado</span>
                        </div>
                        <div class="card-meta">
                            <span><i class="bi @catIcon"></i> @c.Categoria</span>
                            <span><i class="bi bi-percent"></i> @c.DescuentoPct%</span>
                            <span><i class="bi bi-calendar3"></i> @c.FechaInicio.ToString("dd MMM yyyy")</span>
                        </div>
                        <div>
                            <span class="chip-canal">@c.Canal</span>
                        </div>
                        <a asp-action="Detalle" asp-route-id="@c.Id" class="btn-ver-detalle">Ver detalle</a>
                    </div>
                </div>
            }
        </div>
    }
</div>
