@model PortalCampanas.Models.Campana
@{
    ViewData["Title"] = Model.Nombre;
    var badgeClass = Model.Estado switch
    {
        "Vigente"    => "badge-vigente",
        "Próxima"    => "badge-proxima",
        "Finalizada" => "badge-finalizada",
        _            => "badge-finalizada"
    };
    var catIcon = Model.Categoria switch
    {
        "Tecnología" => "bi-cpu",
        "Hogar"      => "bi-house",
        "Moda"       => "bi-bag",
        "Electro"    => "bi-lightning-charge",
        _            => "bi-tag"
    };
}

<div class="container py-4" style="max-width: 680px;">
    <a asp-controller="Campanas" asp-action="Index" class="back-link">
        <i class="bi bi-arrow-left"></i> Volver al listado
    </a>

    <div class="detail-card">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <h1 class="h3 fw-bold mb-0">@Model.Nombre</h1>
            <span class="badge-estado @badgeClass">@Model.Estado</span>
        </div>

        <hr class="detail-divider" />

        <div class="row g-4">
            <div class="col-6">
                <div class="detail-field">
                    <div class="detail-label"><i class="bi bi-tag me-1"></i>Categoría</div>
                    <div class="detail-value"><i class="bi @catIcon me-1"></i>@Model.Categoria</div>
                </div>
            </div>
            <div class="col-6">
                <div class="detail-field">
                    <div class="detail-label"><i class="bi bi-shop me-1"></i>Canal</div>
                    <div class="detail-value">@Model.Canal</div>
                </div>
            </div>
            <div class="col-6">
                <div class="detail-field">
                    <div class="detail-label"><i class="bi bi-calendar-check me-1"></i>Inicio</div>
                    <div class="detail-value">@Model.FechaInicio.ToString("dd 'de' MMMM 'de' yyyy")</div>
                </div>
            </div>
            <div class="col-6">
                <div class="detail-field">
                    <div class="detail-label"><i class="bi bi-calendar-x me-1"></i>Fin</div>
                    <div class="detail-value">@Model.FechaFin.ToString("dd 'de' MMMM 'de' yyyy")</div>
                </div>
            </div>
            <div class="col-12">
                <div class="detail-field">
                    <div class="detail-label"><i class="bi bi-percent me-1"></i>Descuento</div>
                    <div class="detail-value" style="font-size:1.4rem;color:#e8380d;font-weight:700;">@Model.DescuentoPct%</div>
                </div>
            </div>
        </div>

        <hr class="detail-divider" />

        <div class="detail-field">
            <div class="detail-label mb-2">Descripción</div>
            <p style="color:#374151;line-height:1.6;margin:0;">@Model.Descripcion</p>
        </div>
    </div>
</div>
