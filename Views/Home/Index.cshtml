@{
    ViewData["Title"] = "Inicio";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <i class="bi bi-megaphone-fill display-1 text-primary"></i>
        <h1 class="display-5 fw-bold mt-3">Portal de Campañas Comerciales</h1>
        <p class="lead text-muted">
            Gestiona y visualiza campañas activas, próximas y finalizadas desde un solo lugar.
        </p>
        <div class="d-flex gap-3 justify-content-center mt-4">
            <a asp-controller="Campanas" asp-action="Index" class="btn btn-primary btn-lg">
                <i class="bi bi-list-ul me-2"></i>Ver Campañas
            </a>
            <a asp-controller="Campanas" asp-action="Resumen" class="btn btn-outline-secondary btn-lg">
                <i class="bi bi-bar-chart me-2"></i>Ver Resumen
            </a>
        </div>
    </div>

    <div class="row g-4 text-center">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 p-3">
                <div class="card-body">
                    <i class="bi bi-check-circle-fill text-success display-5 mb-3"></i>
                    <h5 class="fw-bold">Campañas Vigentes</h5>
                    <p class="text-muted">Visualiza todas las campañas activas en tiempo real.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 p-3">
                <div class="card-body">
                    <i class="bi bi-funnel-fill text-warning display-5 mb-3"></i>
                    <h5 class="fw-bold">Filtros Avanzados</h5>
                    <p class="text-muted">Filtra por categoría y estado para encontrar lo que necesitas.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 p-3">
                <div class="card-body">
                    <i class="bi bi-graph-up text-primary display-5 mb-3"></i>
                    <h5 class="fw-bold">Indicadores</h5>
                    <p class="text-muted">Consulta métricas y resúmenes calculados en tiempo real.</p>
                </div>
            </div>
        </div>
    </div>
</div>
